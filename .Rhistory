pacman::p_load(
tidyverse,
here,
rio,
naniar,
janitor,
gt
)
hrs_data <- import(here("data", "hrs_data.rds")) |>
mutate(srh = fct_relevel(srh, "Excellent", "Very Good", "Good", "Fair", "Poor"))
hrs_00 <- hrs_data |>
select(ed, race_original, srh, sex, act_vig, height, degree)
#| code-fold: true
#| code-summary: "Create missingness sumamry table with `miss_var_summary()`"
hrs_00 |>
miss_var_summary() |>
gt() |>
tab_options(table.font.size = px(40))
hrs_01_na_rm <- hrs_00 |>
drop_na()
tibble(hrs_01_na_rm)
hrs_02_race_rm <- hrs_00 |>
drop_na(race_original, ed)
hrs_02_race_rm |> miss_var_summary() |>
gt() |>
tab_options(table.font.size = px(40))
hrs_00 |> tabyl(srh)
hrs_03_rm_poor <- hrs_00 |>
filter(srh != "Poor")
hrs_03_rm_poor |> tabyl(srh)
hrs_04_rm_poor <- hrs_00 |>
filter_out(srh == "Poor")
hrs_04_rm_poor |> tabyl(srh)
hrs_05_height_filled <- hrs_00 |>
mutate( #<1>
height_filled = replace_na( #<2>
height, #<3>
mean(height, na.rm = TRUE)) #<4>
) #<1>
#| code-fold: true
#| code-summary: "Check that the function worked"
hrs_05_height_filled |>
select(contains("height")) |>
arrange(height) |> tail()
hrs_06_race_filled <- hrs_00 |>
mutate(
race_filled = fct_na_value_to_level( #<1>
race_original, #<2>
level = "Unknown") #<3>
)
#| code-fold: true
#| code-summary: "Check that the function worked"
hrs_06_race_filled |> tabyl(race_original, race_filled)
hrs_07_other_na <- hrs_06_race_filled |>
mutate( #<1>
sex_na = sex,
height_na = height,
race_filled_na = race_filled
) |> #<1>
replace_with_na(replace = list( #<2>
sex_na = "Male", #<3>
height_na = 1.6002, #<4>
race_filled_na = c("Other", "Unknown") #<5>
))
#| code-fold: true
#| code-summary: "Check `sex_na`"
hrs_07_other_na |>
tabyl(sex, sex_na) |>
gt() |>
tab_options(table.font.size = px(35))
hrs_07_other_na |>
filter(is.na(height_na)) |>
select(height, height_na) |>
head()
hrs_07_other_na |>
filter(is.na(height_na)) |>
select(height, height_na) |>
tibble()
gdsnfs = hrs_07_other_na |>
tabyl(race_filled, race_filled_na) |>
gt() |>
tab_options(table.font.size = px(35))
gdsnfs
??gtsave
gtsave(data=gdsnfs, filename = here("images", "race_table_try.png"))
